# Copiar a deploy/.env y completar. No versionar valores reales.
NODE_ENV=production
PORT=3000

# Compose la sobrescribe con la URI interna; este valor es solo documental.
MONGODB_URI=mongodb://matiapp_app:cambiar@mongo:27017/matiapp?authSource=matiapp

JWT_ACCESS_SECRET=cambiar-por-64-caracteres-hexadecimales
JWT_REFRESH_SECRET=cambiar-por-64-caracteres-hexadecimales
ACCESS_TOKEN_SEGUNDOS=900
REFRESH_TOKEN_SEGUNDOS=604800

# Origen exacto del PWA (sin barra final). Si hay más de uno, separar con coma.
CORS_ORIGINS=https://matiapp.example.com
COOKIE_SAMESITE=lax

ADMIN_USUARIO=admin
ADMIN_NOMBRE=Administrador
ADMIN_PASSWORD=cambiar-por-password-de-16+caracteres
ADMIN_FORZAR_RESET=false

MONGO_ROOT_USER=matiapp_root
MONGO_ROOT_PASSWORD=cambiar-por-password-aleatorio
MONGO_DB=matiapp
MONGO_APP_USER=matiapp_app
MONGO_APP_PASSWORD=cambiar-por-password-aleatorio

# 127.0.0.1 deja la web solo para Cloudflare Tunnel / SSH.
# Usar 0.0.0.0 solo si además se quiere probar por LAN.
WEB_BIND=127.0.0.1
WEB_PORT=8081
