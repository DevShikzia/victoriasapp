# Imagen de producción de la API de MatiApp.
# El contexto de build es la raíz del monorepo (ver docker-compose.prod.yml).

FROM node:22-bookworm-slim AS build
WORKDIR /app

# Manifiestos de todos los workspaces: npm ci valida el lockfile completo.
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/package.json
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json

# El postinstall del monorepo compila shared; se desactiva para compilar
# explícitamente después de copiar el código.
COPY packages/shared ./packages/shared
RUN npm ci --ignore-scripts

COPY apps/api ./apps/api
RUN npm run build -w @victoriasapp/shared \
  && npm run build -w @victoriasapp/api

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/package.json
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json
RUN npm ci --omit=dev --ignore-scripts

COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/apps/api/dist ./apps/api/dist

WORKDIR /app/apps/api
USER node
EXPOSE 3000
CMD ["node", "dist/server.js"]
