# Build del PWA Angular y servidor Nginx con proxy same-origin hacia la API.
# El contexto de build es la raíz del monorepo (ver docker-compose.prod.yml).

FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/package.json
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json

COPY packages/shared ./packages/shared
RUN npm ci --ignore-scripts

COPY apps/web ./apps/web
RUN npm run build -w @victoriasapp/shared \
  && npm run config -w @victoriasapp/web \
  && npm run build -w @victoriasapp/web

FROM nginx:1.27-alpine
COPY --from=build /app/apps/web/dist/web/browser /usr/share/nginx/html
EXPOSE 80
