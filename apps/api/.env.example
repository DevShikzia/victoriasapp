# Ejemplo de variables de entorno de la API (copiar a apps/api/.env).
# NUNCA commitear el .env real (ver docs/12-git-y-deploy.md).

# Servidor
NODE_ENV=development
PORT=3000

# Base de datos (Mongo local levantado con `docker compose up -d mongo`)
MONGODB_URI=mongodb://admin:admin@localhost:27017/victoriasapp?authSource=admin

# Secretos JWT (mínimo 32 caracteres cada uno; generar con `openssl rand -hex 32`)
JWT_ACCESS_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-32+
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-largo-y-aleatorio-de-32+

# Vida de los tokens, en segundos (900 = 15 min, 604800 = 7 días)
ACCESS_TOKEN_SEGUNDOS=900
REFRESH_TOKEN_SEGUNDOS=604800

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:4200

# --- Alta automática del administrador -------------------------------------
# Si ADMIN_PASSWORD está definida y el usuario no existe, se crea al arrancar.
# Si ADMIN_FORZAR_RESET=true, además se resetea la contraseña del admin existente
# (sirve para recuperar el acceso si te quedaste afuera). Ponelo en false luego.
ADMIN_USUARIO=admin
ADMIN_NOMBRE=Administrador
ADMIN_PASSWORD=CambiarEstaClave123
ADMIN_FORZAR_RESET=false
