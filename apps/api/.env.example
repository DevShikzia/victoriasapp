# Entorno de desarrollo
NODE_ENV=development
PORT=3000

# Base de datos (ver docker-compose.yml en la raíz)
MONGODB_URI=mongodb://admin:admin@localhost:27017/victoriasapp?authSource=admin

# Secretos de JWT (usar valores largos y aleatorios en producción)
JWT_ACCESS_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-access
JWT_REFRESH_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-refresh

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:4200
