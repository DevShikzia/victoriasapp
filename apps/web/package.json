{
  "name": "@victoriasapp/web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "postinstall": "node scripts/copy-zxing-wasm.mjs",
    "prestart": "node scripts/copy-zxing-wasm.mjs",
    "start": "ng serve",
    "prestart:lan": "node scripts/copy-zxing-wasm.mjs",
    "start:lan": "ng serve --host 0.0.0.0",
    "prestart:https": "node scripts/copy-zxing-wasm.mjs",
    "start:https": "ng serve --host 0.0.0.0 --ssl --ssl-cert certs/cert.pem --ssl-key certs/key.pem",
    "certs": "node scripts/generar-certificados.mjs",
    "config": "node scripts/generar-config-web.mjs",
    "prebuild": "node scripts/copy-zxing-wasm.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "ng test --watch=false --browsers=ChromeHeadless"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/service-worker": "^20.3.0",
    "@victoriasapp/shared": "*",
    "barcode-detector": "^3.2.2",
    "dexie": "^4.4.6",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.4",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0",
    "zxing-wasm": "^3.1.3"
  },
  "devDependencies": {
    "@angular/build": "^20.3.39",
    "@angular/cli": "^20.3.39",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
