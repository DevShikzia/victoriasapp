{
  "singleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "printWidth": 100,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.md"],
      "options": { "printWidth": 100, "proseWrap": "preserve" }
    },
    {
      "files": ["*.html"],
      "options": { "parser": "angular" }
    }
  ]
}
